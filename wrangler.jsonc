{
  "$schema": "https://unpkg.com/wrangler@4.151.2/config-schema.json",
  "name": "opul-website",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "opul.procka.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
