{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["alchemy.run.ts", "vite.config.ts", "src/**/*", "scripts/**/*"]
}
